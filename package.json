{
  "name": "ebac-ui-automation",
  "version": "1.0.0",
  "description": "Testes automatizados para loja EBAC - Módulo Automação de UI",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:account": "cypress run --spec 'cypress/e2e/account-creation/**'",
    "test:checkout": "cypress run --spec 'cypress/e2e/checkout/**'",
    "test:cart-api": "cypress run --spec 'cypress/e2e/cart-api/**'",
    "test:all": "cypress run",
    "report:merge": "mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/mochawesome/report.json",
    "report:generate": "marge cypress/reports/mochawesome/report.json -f report -o cypress/reports/mochawesome",
    "report:clean": "rm -rf cypress/reports",
    "test:report": "npm run report:clean && npm run test:all && npm run report:merge && npm run report:generate"
  },
  "keywords": [
    "cypress",
    "e2e",
    "testing",
    "automation",
    "ebac"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.6.3",
    "faker": "^5.5.3",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
